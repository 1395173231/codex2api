# 复制为 tools/redeem-and-import.local.env 后填写；脚本会自动读取该文件，不要提交 local.env。
# 如需指定其它路径，可在启动前设置 REDEEM_IMPORT_ENV_FILE。

# 兑换平台
CDK_REDEEM_URL=https://zzledu.kdns.fr/api/cdk/redeem
# 从兑换平台请求复制 x-cdk-client；若平台不校验可留空
CDK_CLIENT=
# 每行一个 CDK；不要直接把 key 写入此示例文件
CDK_KEYS_FILE=./tools/cdk-keys.txt
# 默认每次一个，减少达到目标后多兑换的风险
CDK_BATCH_SIZE=1

# Codex2API
CODEX2API_BASE_URL=https://codex2api.example.com
CODEX2API_ADMIN_KEY=
CODEX2API_GROUP_IDS=[2]
# 可选：达到目标后自动停止；二选一
CODEX2API_TARGET_AVAILABLE=8
# CODEX2API_TARGET_TOTAL=8
# CODEX2API_IMPORT_FORMAT=json
# CODEX2API_ALLOW_DUPLICATE=false

# 可选：下载后保留凭证 JSON（这是敏感文件）
# CDK_SAVE_DOWNLOADS_DIR=./.redeemed-accounts
# 出错时是否立即停止；默认 false，会继续处理后续 CDK
# STOP_ON_ERROR=false
# CHECK_CODEX2API_STATUS=true
# STATUS_POLL_ATTEMPTS=3
# STATUS_POLL_DELAY_MS=1000
# HTTP_TIMEOUT_MS=60000
# HTTP_RETRIES=3
# Web 面板（默认只监听本机）
# PANEL_HOST=127.0.0.1
# PANEL_PORT=8787
# 非回环监听时必须设置强随机 PANEL_TOKEN
# PANEL_TOKEN=
